# Copia este archivo como .env.local y rellena los valores de tu proyecto en Supabase
# (Project Settings -> API Keys / Data API).
NEXT_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxx

# Solo servidor (NUNCA con prefijo NEXT_PUBLIC_). Se usa para crear cuentas al admitir miembros.
# Supabase -> Project Settings -> API Keys -> Secret keys.
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxxxxxxxxxx

# Correo de bienvenida (mismo Gmail y contraseña de aplicación que el SMTP de Supabase).
SMTP_USER=tu-correo@gmail.com
SMTP_PASSWORD=contraseña-de-aplicacion-de-16-letras
